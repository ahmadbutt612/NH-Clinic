# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Doctor accounts. Keep these server-side and never prefix them with NEXT_PUBLIC_.
DOCTOR_UMAR_EMAIL=umar@example.com
DOCTOR_UMAR_PASSWORD=replace-with-a-strong-password
DOCTOR_SOFIA_EMAIL=sofia@example.com
DOCTOR_SOFIA_PASSWORD=replace-with-a-strong-password

# Optional: avoids the Supabase CLI database-password prompt during setup.
SUPABASE_DB_PASSWORD=

# Optional until email delivery is enabled.
RESEND_API_KEY=
RESEND_FROM_EMAIL=NH Gyne Clinic <appointments@your-verified-domain.com>
